# Copy to backend/.env (same folder) and edit. backend/.env is git-ignored.

# Database selection: sqlite | mysql | url
DB_ENGINE=mysql

# Used when DB_ENGINE=mysql
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=ChangeThisPassword123!
DB_HOST=127.0.0.1
DB_PORT=3306

# Used when DB_ENGINE=url  (hosted MySQL/Postgres, e.g. PlanetScale, Aiven, Render)
# DATABASE_URL=mysql://user:pass@host:3306/hrms_db

# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=replace-me
# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost

# Session / token tuning
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_RATE=20/min
TIME_ZONE=Asia/Kolkata
LATE_AFTER=09:30

# Frontend origins allowed to call the API (only matters if you skip the Vite proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Print every SQL statement Django runs - useful while learning the ORM
# SQL_LOG_LEVEL=DEBUG
